<?xml version="1.0" encoding="utf-8"?>
<!-- Today overview (large): the date, the agenda, tasks due, the day's summary line and headlines.
     Each section hides when it has nothing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/omi_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/omi_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/omi_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/omi_widget_overview_name"
        android:textColor="@color/omi_widget_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/omi_widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/omi_widget_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/omi_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/omi_widget_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/omi_widget_events_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/omi_widget_text_tertiary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <TextView
        android:id="@+id/omi_widget_events"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/omi_widget_text_primary"
        android:textSize="14sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/omi_widget_tasks_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/omi_widget_text_tertiary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <TextView
        android:id="@+id/omi_widget_tasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/omi_widget_text_primary"
        android:textSize="14sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/omi_widget_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/omi_widget_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/omi_widget_news_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/omi_widget_text_tertiary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <TextView
        android:id="@+id/omi_widget_news"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/omi_widget_text_primary"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
