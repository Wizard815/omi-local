<?xml version="1.0" encoding="utf-8"?>
<!-- Status widgets (Today, Summary, Mute, Live translation): a title, one large line, a detail
     line and an optional pill action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/omi_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/omi_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/omi_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/omi_widget_today_name"
        android:textColor="@color/omi_widget_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/omi_widget_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/omi_widget_preview_value"
        android:textColor="@color/omi_widget_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/omi_widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/omi_widget_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/omi_widget_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/omi_widget_button"
        android:gravity="center"
        android:minHeight="40dp"
        android:minWidth="88dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/omi_widget_on_accent"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
