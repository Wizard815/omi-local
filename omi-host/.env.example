# Copy this file to .env (same directory) and fill in what you need.
# run-omi-local-host.sh sources this automatically — anything set here behaves
# exactly like exporting it on the command line, so you no longer need to type
# LLAMA_HOST=... every time you run ./run-omi-local-host.sh.
# Lines left commented out use the script's/compose's built-in default.

# ── Network ──
# BIND_IP=192.168.20.5              # auto-detected from the default route if unset
# BACKEND_PORT=8000                 # host-side port for the backend API — change if 8000 is
                                     # already taken; the container still listens on 8000
                                     # internally, so this has no effect on Cloudflare Tunnel
                                     # routes (those use http://omi-local:8000 either way)

# ── LLM backend (your own OpenAI-compatible server, e.g. llama.cpp) ──
# LLAMA_HOST=172.19.0.4
# LLAMA_PORT=8081
# OPENROUTER_API_KEY=sk-or-...      # optional: adds OpenRouter models alongside llama.cpp
# OMI_LOCAL_MODEL=llama/gemma-4-12b # merge-proxy-tagged model name, sets the dashboard default
# LOCAL_LLM_MODEL=llama/gemma-4-12b
# MODEL_ALLOW=gemma-4-12b,qwen3-8b  # curate the dashboard's model dropdown (empty = show all)

# Raise these if conversation processing or chat times out on the first
# request after a cold local-LLM model load (e.g. llama-swap loading a model
# for the first time since idle-unload) — 60s/35s is tuned for
# already-warm cloud models, not a GPU spinning up a fresh load. Try
# 180-300 if you're seeing timeouts right after periods of LLM inactivity.
# FOREGROUND_REQUEST_TIMEOUT_SECONDS=180
# BACKGROUND_CHAT_EXTRACTION_TIMEOUT_SECONDS=180

# ── Chat model shortcuts ("/adult …" in Ask Omi) ──
# Type "/adult your question" to answer one message with a bigger model, or
# "/adult toggle" to keep using it until you toggle it off. Pick the model in
# the dashboard (Chat Model Shortcuts card) or with /model in the app; this
# only seeds defaults. Names may not shadow app commands (model, clear, ...).
# OMI_CHAT_MODEL_SHORTCUTS=adult=llama/big-model,code=llama/coder

# ── Daily recap + end-of-day review ──
# OMI_CONVERSATION_HOLD=on          # on (default): clips wait for the day review, no model call until you sort them | off: process each clip as it ends
# OMI_LOCAL_SCHEDULER=1             # hourly in-process recap job (default on; 0 = off)
# DAY_REVIEW_TIMEOUT_SECONDS=240    # max time for one day summary on the local model
# DAY_REVIEW_MAX_INPUT_CHARS=28000  # day material sent to the model; lower for small-context models

# ── Provider mode ──
# PROVIDER_MODE=offline             # offline (default, no cloud keys needed) | real

# ── STT / audio (omi-audio container) ──
# Self-contained by default: omi-audio transcribes on this GPU. To use another
# local engine (speaches, LocalAI, ...), a frontier API (OpenAI, Groq), or an
# omi-audio on another machine, copy a recipe from examples/audio/ (README.md
# there explains each one).
# OMI_ASR_ENGINE=whispercpp         # whispercpp (GPU, gfx906) | fasterwhisper (CPU) | openai (OMI_ASR_URL)
# WHISPER_MODEL=large-v3-turbo
# OMI_ASR_MODEL=Systran/faster-whisper-small   # fasterwhisper or openai engine model
# OMI_ASR_URL=http://192.168.20.10:8001/v1     # openai engine: base URL up to /v1
# OMI_ASR_API_KEY=                  # openai engine: bearer key, if it needs one
# OMI_ASR_LANGUAGE=en               # or auto
# OMI_AUDIO_URL=                    # backend's audio service: empty = bundled omi-audio | http://host:8790 | off
# OMI_DIA_DEVICE=cuda               # cuda (GPU diarization; keeps some VRAM while idle) | cpu
# OMI_ASR_IDLE_UNLOAD_S=300         # seconds of idle before unloading the model from GPU (0 = never)
# OMI_VAD_MIN_SILENCE_MS=1000       # silence (ms) after speech before cutting the utterance — raise to listen longer after a pause
# OMI_VAD_THRESH_REL=0.12           # voice-detection sensitivity relative to recent peak volume — lower to pick up quieter speech
# OMI_ASR_BEAM_SIZE=5               # beam search width — higher catches more words correctly, decodes slower; set to 1 for plain greedy decoding
# OMI_ASR_BEST_OF=5                 # candidates kept per decode step — only matters when OMI_ASR_BEAM_SIZE=1
# DEEPGRAM_API_KEY=                 # leave unset — setting this re-enables cloud STT
# MODULATE_API_KEY=                 # leave unset — setting this re-enables cloud STT
# SONIOX_API_KEY=                   # leave unset — setting this re-enables cloud STT

# ── GPU passthrough (Dockerfile.audio, ROCm/HIP for AMD gfx906) ──
# Find these on the host with: getent group render video
# RENDER_GID=105
# VIDEO_GID=44

# ── Data durability (the Firestore emulator keeps your data in memory) ──
# OMI_FIRESTORE_EXPORT_INTERVAL_S=900   # export to the data volume this often (0 = only on a clean stop)
# OMI_BACKUP_INTERVAL_S=86400           # tarball of firebase-export/redis/storage/chroma/secrets into /data/backups
# OMI_BACKUP_KEEP=7                     # newest tarballs to keep
# OMI_FIRESTORE_HEAP=2g                 # max heap of the Firestore emulator's JVM (holds the whole dataset)

# ── Local infrastructure ──
# LOCAL_VECTOR_DB=chroma            # embedded ChromaDB, no separate server
# STORAGE_BACKEND=local
# LOCAL_STORAGE_PATH=/data/storage
# CHROMA_DATA_PATH=/data/chroma/vector_db
# PIPER_VOICE_DIR=/mnt/user/appdata/omi-local-audio/piper/voices

# ── Optional local web search (SearXNG) ──
# SEARXNG_ENABLED=1                 # 1 starts the searxng container alongside the stack

# ── Optional Firestore Emulator UI (data browser), behind HTTP Basic Auth ──
# The Emulator UI itself has zero authentication, so it's never published
# directly — only through firestore-ui-proxy (nginx + Basic Auth), and only
# when explicitly enabled. Refuses to start if the username/password are
# missing rather than serve the UI unauthenticated.
# FIRESTORE_UI_ENABLED=1

# ── Optional chat-tool apps (omi-host/apps-gateway) ──
# Starts a single gateway container mounting no-auth lookup apps (Wikipedia,
# Open Library, Open-Meteo weather, Open Food Facts — one image, not one
# container each) plus a separate bridge to a self-hosted Hermes Agent
# instance. Each still needs registering as an "app" (Chat Tools Manifest
# URL) once running — see backend/scripts/register_chat_apps.py.
# OMI_APPS_ENABLED=1
# OMI_APPS_LIST=wikipedia,open-library,open-meteo,openfoodfacts   # comma-separated plugins/omi-<slug>-app slugs to mount — add one and restart (no rebuild) to enable it
# HERMES_API_URL=http://<your-NUC-LAN-IP>:8642   # Hermes Agent's API server — a DIFFERENT machine than this one
# HERMES_API_KEY=                                 # API_SERVER_KEY from that Hermes profile's .env
# OMI_ALLOWED_UIDS=                               # your Omi uid(s), comma-separated — both allowlists are mandatory, the bridge fails closed (503) without them
# OMI_ALLOWED_APP_IDS=                            # filled in after you create the app and get its app_id
# FIRESTORE_UI_USERNAME=admin
# FIRESTORE_UI_PASSWORD=
# FIRESTORE_UI_PORT=8086             # reachable at http://<BIND_IP>:8086 once enabled

# ── Login (LAN and internet alike, e.g. behind Cloudflare Tunnel) ──
# The app signs in through /v1/auth/local-login (backend/utils/local_auth.py):
# the backend checks the password and signs its own session token with this
# secret — no Firebase, no Google, nothing leaves this box. Left unset, one is
# generated on first start and kept in the data volume (/data/secrets), so
# sessions survive restarts. Set it only to pin your own:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# LOCAL_AUTH_JWT_SECRET=

# The web dashboard (/, model picker, conversation retry) has no auth of its
# own otherwise — fine on a LAN-only deployment, but it's served by this
# same backend, so a public Cloudflare Tunnel exposes it too. Set both if
# you're internet-facing at all; leave unset only for LAN-only deployments.
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD=

# If running cloudflared as part of this stack (see the cloudflared example
# in docker-compose.override.yml.example) — token from the Cloudflare Zero
# Trust dashboard, Networks > Tunnels > your tunnel.
# TUNNEL_TOKEN=
