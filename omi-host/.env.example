# Copy this file to .env (same directory) and fill in what you need.
# run-omi-local-host.sh sources this automatically — anything set here behaves
# exactly like exporting it on the command line, so you no longer need to type
# LLAMA_HOST=... every time you run ./run-omi-local-host.sh.
# Lines left commented out use the script's/compose's built-in default.

# ── Network ──
# BIND_IP=192.168.20.5              # auto-detected from the default route if unset
# BACKEND_PORT=8000                 # host-side port for the backend API — change if 8000 is
                                     # already taken; the container still listens on 8000
                                     # internally, so this has no effect on Cloudflare Tunnel
                                     # routes (those use http://omi-local:8000 either way)

# ── LLM backend (your own OpenAI-compatible server, e.g. llama.cpp) ──
# LLAMA_HOST=172.19.0.4
# LLAMA_PORT=8081
# OPENROUTER_API_KEY=sk-or-...      # optional: adds OpenRouter models alongside llama.cpp
# OMI_LOCAL_MODEL=llama/gemma-4-12b # merge-proxy-tagged model name, sets the dashboard default
# LOCAL_LLM_MODEL=llama/gemma-4-12b
# MODEL_ALLOW=gemma-4-12b,qwen3-8b  # curate the dashboard's model dropdown (empty = show all)

# ── Provider mode ──
# PROVIDER_MODE=offline             # offline (default, no cloud keys needed) | real

# ── STT / audio (omi-audio container) ──
# OMI_ASR_ENGINE=whispercpp         # whispercpp (GPU, gfx906) | fasterwhisper (CPU fallback)
# WHISPER_MODEL=large-v3-turbo
# OMI_ASR_MODEL=Systran/faster-whisper-small   # only used when OMI_ASR_ENGINE=fasterwhisper
# OMI_DIA_DEVICE=cuda               # cuda (GPU diarization) | cpu
# OMI_ASR_IDLE_UNLOAD_S=300         # seconds of idle before unloading the model from GPU (0 = never)
# DEEPGRAM_API_KEY=                 # leave unset — setting this re-enables cloud STT
# MODULATE_API_KEY=                 # leave unset — setting this re-enables cloud STT

# ── GPU passthrough (Dockerfile.audio, ROCm/HIP for AMD gfx906) ──
# Find these on the host with: getent group render video
# RENDER_GID=105
# VIDEO_GID=44

# ── Local infrastructure ──
# LOCAL_VECTOR_DB=chroma            # embedded ChromaDB, no separate server
# STORAGE_BACKEND=local
# LOCAL_STORAGE_PATH=/data/storage
# CHROMA_DATA_PATH=/data/chroma/vector_db
# PIPER_VOICE_DIR=/mnt/user/appdata/omi-local-audio/piper/voices

# ── Optional local web search (SearXNG) ──
# SEARXNG_ENABLED=1                 # 1 starts the searxng container alongside the stack

# ── Remote (internet-facing) login, e.g. behind Cloudflare Tunnel ──
# LAN-only access needs nothing here — the app talks to the Auth emulator on
# :9099 directly. That doesn't work through a normal Cloudflare Tunnel (its
# HTTPS-only edge can't forward that raw port), so /v1/auth/local-login
# exists instead (see backend/utils/local_auth.py): it checks the password
# itself AND signs its own session token with this secret — no Firebase, no
# Google, nothing leaves this box at any point. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Required for the "Remote (internet)" login option in the app; LAN login
# works with this left unset.
# LOCAL_AUTH_JWT_SECRET=

# If running cloudflared as part of this stack (see the cloudflared example
# in docker-compose.override.yml.example) — token from the Cloudflare Zero
# Trust dashboard, Networks > Tunnels > your tunnel.
# TUNNEL_TOKEN=
