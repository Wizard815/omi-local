FROM python:3.11-slim
RUN pip install --no-cache-dir fastapi uvicorn httpx redis
COPY merge_proxy.py /app/
# Local-only egress guard (see egress-guard/sitecustomize.py); OMI_EGRESS_GUARD comes from compose.
COPY egress-guard/sitecustomize.py /app/egress-guard/sitecustomize.py
ENV PYTHONPATH=/app/egress-guard
WORKDIR /app
EXPOSE 4000
CMD ["uvicorn", "merge_proxy:app", "--host", "0.0.0.0", "--port", "4000"]