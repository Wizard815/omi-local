# Copy to docker-compose.override.yml (same directory) for changes that a
# .env variable can't express — port bindings, extra volumes, device paths,
# restart policy, etc. run-omi-local-host.sh picks this up automatically if
# it exists (see COMPOSE_FILES in that script); leave it deleted/absent to
# run with the plain docker-compose.yml defaults.
#
# Compose merges this on top of docker-compose.yml service-by-service —
# you only need to list the keys you're actually changing, not whole services.

# `omi-local: {}` below is a harmless no-op override (merging an empty object
# onto a real service changes nothing) — it exists only so this file is valid
# YAML if you copy it as-is with nothing else uncommented. Leave it in place
# even after uncommenting other examples; it doesn't conflict with them.

services:
  omi-local: {}

  # Example: expose the audio service on the LAN instead of localhost-only,
  # e.g. to hit http://<host-ip>:8790/health from another machine for debugging.
  # omi-audio:
  #   ports:
  #     - "0.0.0.0:8790:8790"

  # Example: different render/video group ids than the .env RENDER_GID/VIDEO_GID
  # defaults, or a second GPU's device nodes.
  # omi-audio:
  #   devices:
  #     - /dev/kfd
  #     - /dev/dri/renderD129
  #   group_add:
  #     - "106"
  #     - "45"

  # Example: mount an extra host path into the backend container, e.g. to read
  # exported recordings from elsewhere on the NAS.
  # NOTE: Compose REPLACES a service's whole `volumes:` list on override, it
  # doesn't append — repeat the entries you want to keep alongside new ones.
  # omi-local:
  #   volumes:
  #     - omi-data:/data
  #     - /mnt/user/exports:/exports:ro

  # Example: put ALL of omi-data's contents (recordings, Chroma vectors, Piper
  # voices, HF model cache) at a specific host path instead of Docker's managed
  # volume storage — e.g. a NAS share you back up separately. Bind-mount the
  # host path directly on every service that currently uses the named volume,
  # instead of declaring `omi-data` itself (see the top-level `volumes:` note
  # at the bottom of this file for why that path doesn't work as well).
  # omi-local:
  #   volumes:
  #     - /mnt/user/appdata/omi-local-data:/data
  # omi-audio:
  #   volumes:
  #     - /mnt/user/appdata/omi-local-data:/data

  # Example: always start SearXNG with the main stack instead of only when
  # SEARXNG_ENABLED=1 is set (this removes the `profiles: [searxng]` gate).
  # searxng:
  #   profiles: []

  # Example: attach every service to an existing Docker network instead of
  # the one Compose creates for this project — e.g. to reach another stack's
  # containers by name, or because a network named "omi" already exists from
  # something else on this host and Compose refuses to reuse it ("network
  # with name omi exists but was not created by compose"). Requires the
  # top-level `networks:` block below to be uncommented too.
  # omi-local:
  #   networks: [omi]
  # omi-proxy:
  #   networks: [omi]
  # omi-audio:
  #   networks: [omi]

# Uncomment alongside the `networks: [omi]` service entries above.
# external: true tells Compose "this network already exists, don't manage
# it" — required when the network wasn't created by this compose project.
# networks:
#   omi:
#     external: true

# A named volume itself (as opposed to what mounts it) can't be redirected to
# an arbitrary host path from an override file — `driver_opts`/`device` on a
# `local` driver volume only accepts real mount options (e.g. an already-
# mounted NFS/CIFS share), not a plain directory path. For a plain local
# directory, bind-mount it per-service instead (see the omi-data example
# above) rather than trying to override the volume's own definition here.
