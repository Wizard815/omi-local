# Recipe: no omi-audio at all; the backend talks to a cloud STT provider itself.
# PRIVACY: all audio goes to that provider. See README.md for what you lose.
#
# Apply:
#   1. copy the uncommented lines below into omi-host/.env (with a real key)
#   2. add no-bundled-audio.override.yml to omi-host/docker-compose.override.yml
#   3. cd omi-host && docker compose up -d && docker compose rm -sf omi-audio
#
# Without a local audio service there is no speaker identification (voice
# profiles), no spoken replies, and synced recordings are transcribed only
# with a Modulate key (Deepgram serves live audio only).

OMI_AUDIO_URL=off

# At least one, or omi-local refuses to start. Several: tried in this order.
# MODULATE_API_KEY=
# SONIOX_API_KEY=
DEEPGRAM_API_KEY=REPLACE-ME
