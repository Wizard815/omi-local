# Recipe: keep the bundled omi-audio, transcribe with Groq's hosted Whisper.
# PRIVACY: every utterance you record is sent to Groq and billed per minute.
# See README.md for what this changes and why.
#
# Apply: copy the uncommented lines into omi-host/.env, then
#   cd omi-host && docker compose up -d
#
# The same shape works for any hosted OpenAI-compatible speech API: change the
# URL, key and model id.

OMI_ASR_ENGINE=openai
OMI_ASR_URL=https://api.groq.com/openai/v1
OMI_ASR_API_KEY=gsk_REPLACE-ME
OMI_ASR_MODEL=whisper-large-v3-turbo

# OMI_DIA_DEVICE=cpu
