# Recipe: run omi-audio on ANOTHER machine (e.g. the box with the GPU) and none
# on this one. See README.md for what this changes and why.
#
# This machine (the one running omi-local):
#   1. copy the uncommented lines below into omi-host/.env
#   2. add no-bundled-audio.override.yml to omi-host/docker-compose.override.yml
#   3. cd omi-host && docker compose up -d && docker compose rm -sf omi-audio
# The other machine: start gateway-machine.compose.yml (instructions inside).

# Where that omi-audio listens, as seen from INSIDE the omi-local container.
OMI_AUDIO_URL=http://192.168.20.10:8790

# Which engine it transcribes with is set over there, in its own .env
# (OMI_ASR_ENGINE, OMI_ASR_URL, ...), exactly like the other recipes here.
